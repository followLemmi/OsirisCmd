<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:OsirisCmd.UI.Application.FileSearcher"
        xmlns:avalonEdit="https://github.com/avaloniaui/avaloniaedit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OsirisCmd.UI.Application.FileSearcher.FilePreviewWindow"
        Title="Preview">
    
    <Grid>
        <avalonEdit:TextEditor Name="FilePreview" ShowLineNumbers="True"  Document="{Binding FileContentDocument}">
            
        </avalonEdit:TextEditor>   
    </Grid>
</Window>
